/* =============================================================================
 * clean_light.qss — HMI 라이트 테마 (커스텀 QSS)
 * 2026-06-28: qt_material 대체. 색/여백 수정은 이 파일만 고치면 됨.
 * 주의: LED/튜브색/비상정지 빨강 등 동적 색상 위젯은 코드에서 개별 setStyleSheet로
 *       오버라이드되므로 이 전역 QSS 위에서도 그대로 유지된다.
 * ========================================================================== */

/* 1. 전체 배경 및 기본 글꼴 (맑고 깨끗한 느낌) */
QWidget {
    background-color: #f8f9fa; /* 아주 연한 회색 배경 */
    color: #1e293b; /* 너무 진하지 않은 부드러운 검은색 */
    font-family: "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", sans-serif;
    font-size: 13px; /* 2026-06-28: 고정 27px 위젯 글자 세로잘림 방지 위해 축소 */
}

/* 2. 그룹 박스 (흰색 카드 형태) */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0; /* 아주 연한 회색 테두리 */
    border-radius: 8px; /* 둥근 모서리 */
    margin-top: 24px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 10px;
    color: #475569;
}

/* 3. 일반 버튼 (플랫하고 모던한 스타일) */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 3px 14px; /* 2026-06-28: 고정 27px 버튼 글자 세로잘림 방지 */
    border-radius: 6px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #f1f5f9; /* 마우스 올렸을 때 살짝 어두워짐 */
    border: 1px solid #94a3b8;
}
QPushButton:pressed {
    background-color: #e2e8f0;
}

/* 4. 텍스트 입력창 및 스핀박스 */
QLineEdit, QDoubleSpinBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 6px 8px;
    color: #0f172a;
}
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 2px solid #3b82f6; /* 클릭 시 선명한 파란색 테두리 (포인트) */
    outline: none;
}

/* 5. 탭 메뉴 */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    background: #ffffff;
    border-radius: 8px;
}
QTabBar::tab {
    background: #f8f9fa;
    color: #64748b;
    padding: 10px 24px;
    border: 1px solid transparent;
    font-weight: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-bottom: 1px solid #ffffff; /* 본문과 자연스럽게 연결 */
}
QTabBar::tab:hover:!selected {
    background: #f1f5f9;
}

/* 6. 라벨 — 배경 투명 (카드/페이지 위에서 회색 박스로 보이는 문제 해결).
 *    동적 색상 라벨(LED/튜브색/경고배너)은 코드에서 직접 배경색을 주므로 그게 우선됨. */
QLabel {
    background: transparent;
}

/* 7. 콤보박스 — 입력창과 동일한 흰색 카드 (글자 잘림 방지용 패딩/높이 포함) */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 3px 8px; /* 2026-06-28: 고정 27px 콤보 글자 세로잘림 방지 */
    color: #0f172a;
}
QComboBox:focus {
    border: 2px solid #3b82f6;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

/* 8. 로그/멀티라인 텍스트 — 흰색 카드 */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #0f172a;
}

/* 9. 스크롤 영역 배경 투명 (관리자 로봇파라미터 탭 등) */
QScrollArea {
    background: transparent;
    border: none;
}

/* 10. 대시보드 그립실패 경고 영역(groupBox_alert) — 평소엔 자식이 모두 숨김이라
 *     빈 카드로만 보이므로 테두리/배경 제거. 경고 발생 시 빨간 라벨이 자체 스타일로 표시됨. */
QGroupBox#groupBox_alert {
    border: none;
    background: transparent;
    margin-top: 0;
}

/* 11. 시스템 관리자 '적용' 버튼 통일 (크기/폰트/색).
 *     코드에서 각 적용 버튼에 objectName="admin_apply_btn" 부여. */
QPushButton#admin_apply_btn {
    min-height: 32px;
    font-size: 13px;
    font-weight: bold;
    background-color: #1565C0;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 4px 18px;
}
QPushButton#admin_apply_btn:hover { background-color: #1976D2; }
QPushButton#admin_apply_btn:pressed { background-color: #0D47A1; }
QPushButton#admin_apply_btn:disabled { background-color: #94a3b8; color: #e2e8f0; }

/* =============================================================================
 * 12. 시스템 관리자 로그인 화면 (page_login)
 *     .ui 인라인 스타일은 strip되므로 objectName 기준으로 여기서 스타일링.
 * ========================================================================== */
QLabel#lbl_login_title {
    font-size: 26px;
    font-weight: bold;
    color: #1565C0;
}
QLabel#lbl_login_desc {
    font-size: 13px;
    color: #64748b;
}

/* 로그인 카드 */
QGroupBox#groupBox_login {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-top: 0;
}
/* 카드 안 라벨(아이디/비밀번호) — 상태 라벨은 자체 인라인 스타일 유지(빨강) */
QGroupBox#groupBox_login QLabel {
    font-size: 14px;
    font-weight: 600;
    color: #334155;
}

/* 입력칸 */
QLineEdit#input_admin_id, QLineEdit#input_admin_pw {
    min-height: 34px;
    font-size: 14px;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 12px;
}
QLineEdit#input_admin_id:focus, QLineEdit#input_admin_pw:focus {
    border: 2px solid #3b82f6;
    background-color: #ffffff;
}

/* 로그인 버튼 */
QPushButton#btn_admin_login {
    min-height: 44px;
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    background-color: #1565C0;
    border: none;
    border-radius: 8px;
}
QPushButton#btn_admin_login:hover { background-color: #1976D2; }
QPushButton#btn_admin_login:pressed { background-color: #0D47A1; }

/* 13. 시스템 정보 — 개발 환경 표 */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #eef2f6;
}
QHeaderView::section {
    background-color: #1565C0;
    color: #ffffff;
    font-weight: bold;
    padding: 6px 8px;
    border: none;
}
QTableWidget::item {
    padding: 4px 8px;
    color: #334155;
}
